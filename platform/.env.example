# --- Core --------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://frontdesk:frontdesk@localhost:5432/frontdesk
PUBLIC_BASE_URL=http://localhost:3000

# --- Single-tenant bootstrap -------------------------------------------------
# The schema is tenant/bot scoped. This deployment seeds one tenant and one bot
# until the dashboard owns tenant management.
TENANT_SLUG=aossie
TENANT_NAME=AOSSIE
BOT_SLUG=frontdesk
BOT_NAME=AOSSIE Front Desk
# Optional provider-managed prompt appended to agent/instructions.md.
# BOT_SYSTEM_PROMPT=

# --- Model -------------------------------------------------------------------
# Either use an OpenAI-compatible endpoint...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=openai/gpt-5.4-mini
# LLM_CONTEXT_WINDOW=128000
# ...or route a model id through the Vercel AI Gateway.
AI_GATEWAY_API_KEY=replace-me

# --- Discord -----------------------------------------------------------------
DISCORD_BOT_TOKEN=replace-me
DISCORD_PUBLIC_KEY=replace-me
DISCORD_APPLICATION_ID=replace-me
# Raw channel id or full Chat SDK id. The bot answers maintainer replies there.
DISCORD_MAINTAINER_CHANNEL_ID=123456789012345678
# Optional comma-separated channel ids the bot should answer in guilds.
DISCORD_RESPOND_TO_CHANNEL_IDS=123456789012345678
# The Discord Gateway listener forwards regular messages here.
DISCORD_GATEWAY_WEBHOOK_URL=http://127.0.0.1:3000/eve/v1/discord
DISCORD_GATEWAY_DURATION_MS=21600000

# --- WhatsApp ----------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_VERIFY_TOKEN=replace-me

# --- Workflow world ----------------------------------------------------------
# @workflow/world-postgres reads WORKFLOW_POSTGRES_URL, then DATABASE_URL.
# WORKFLOW_POSTGRES_URL=postgres://frontdesk:frontdesk@localhost:5432/frontdesk
# WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
# WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10

# --- Container bootstrap -----------------------------------------------------
# The Docker entrypoint runs these once when set to "true".
RUN_MIGRATIONS=false
RUN_SEED=false
RUN_WORKFLOW_BOOTSTRAP=false
