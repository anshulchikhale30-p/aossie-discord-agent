{
  "name": "@aossie/frontdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "description": "Reusable AI front-desk library and reference deployment for Discord and WhatsApp.",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./chat": "./src/chat/index.ts"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build --skip-sandbox-prewarm",
    "build:full": "eve build",
    "start": "eve start --host 0.0.0.0",
    "gateway": "tsx scripts/discord-gateway.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "workflow:bootstrap": "bootstrap"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@chat-adapter/discord": "^4.45.0",
    "@chat-adapter/state-pg": "^4.45.0",
    "@chat-adapter/whatsapp": "^4.45.0",
    "@workflow/world-postgres": "^5.2.0",
    "chat": "^4.45.0",
    "drizzle-orm": "^0.45.4",
    "eve": "^1.0.0-rc.18",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
