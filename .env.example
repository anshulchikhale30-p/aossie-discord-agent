# Required
DISCORD_TOKEN=replace-with-your-discord-bot-token

# Optional provider dashboard API
FRONTDESK_API_TOKEN=replace-with-a-long-dashboard-api-token
FRONTDESK_API_ORIGIN=https://your-dashboard.example.com

# Organization defaults
DEFAULT_ORG=aossie
ORG_CATALOG=./config/orgs.json

# Storage
DATABASE_PATH=./data/frontdesk.db
DOCS_DIR=./data/docs
AUDIT_LOG=./data/audit.jsonl

# Optional local model
USE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional behavior
REPO_DOCS_ENABLED=true
DOCS_CACHE_TTL_HOURS=24
REMINDER_OFFSETS_MINUTES=1440,60,10
BOOKING_LEAD_MINUTES=30
SLOT_LOOKAHEAD_DAYS=14
SUPPORT_CHANNEL_WORDS=agent,support,help,ask,questions,gsoc,frontdesk,front-desk
STAFF_CHANNEL_WORDS=staff,maintainer,maintainers,admin,moderator,mods
STAFF_ROLE_NAMES=admin,administrator,maintainer,maintainers,core team,staff,moderator,owner

# Restricted demo instance
DEMO_MODE=false
DEMO_ALLOWED_USER_IDS=

# Optional instant guild command sync (comma-separated guild IDs)
COMMAND_SYNC_GUILD_IDS=

# Legacy single-channel setting; still honored if present
DISCORD_CHANNEL_ID=
